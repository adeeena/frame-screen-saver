# Navitia (open-source, navitia.io) — used when transit.provider = 'navitia'
# Free token at https://navitia.io
NAVITIA_TOKEN=your_navitia_token

# PRIM (Île-de-France Mobilités) — used when transit.provider = 'prim'
# Free key at https://data.iledefrance-mobilites.fr
PRIM_API_KEY=your_prim_api_key

MEDIA_DIR=../media

