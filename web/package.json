{
  "name": "frame-screen-saver",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "node --openssl-legacy-provider node_modules/@angular/cli/bin/ng serve --host 0.0.0.0 --port 4500",
    "start:api": "node dist/frame-screen-saver/server/main.js",
    "start:ssr": "node dist/frame-screen-saver/server/main.js",
    "build": "npm run build:browser && npm run build:server",
    "build:browser": "node --openssl-legacy-provider node_modules/@angular/cli/bin/ng build",
    "build:server": "node --openssl-legacy-provider node_modules/@angular/cli/bin/ng run frame-screen-saver:server",
    "watch": "node --openssl-legacy-provider node_modules/@angular/cli/bin/ng build --watch --configuration development",
    "test": "node --openssl-legacy-provider node_modules/@angular/cli/bin/ng test"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "~11.2.0",
    "@angular/common": "~11.2.0",
    "@angular/compiler": "~11.2.0",
    "@angular/core": "~11.2.0",
    "@angular/forms": "~11.2.0",
    "@angular/platform-browser": "~11.2.0",
    "@angular/platform-browser-dynamic": "~11.2.0",
    "@angular/platform-server": "~11.2.0",
    "@angular/router": "~11.2.0",
    "@nguniversal/express-engine": "~11.2.0",
    "axios": "^0.27.2",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "feather-icons": "^4.29.2",
    "fs-extra": "^9.1.0",
    "gsap": "^3.11.5",
    "gtfs-realtime-bindings": "^2.0.0",
    "moment": "^2.30.1",
    "moment-timezone": "^0.5.43",
    "node-ical": "^0.16.0",
    "rxjs": "~6.6.0",
    "sharp": "^0.32.6",
    "tslib": "^2.3.0",
    "zone.js": "~0.11.4"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "~0.1102.0",
    "@angular/cli": "~11.2.0",
    "@angular/compiler-cli": "~11.2.0",
    "@nguniversal/builders": "~11.2.0",
    "@types/express": "^4.17.13",
    "@types/feather-icons": "^4.29.2",
    "@types/fs-extra": "^9.0.13",
    "@types/jasmine": "~3.10.0",
    "@types/node": "^12.20.55",
    "jasmine-core": "~3.8.0",
    "karma": "~6.3.4",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "~2.0.3",
    "karma-jasmine": "~4.0.1",
    "karma-jasmine-html-reporter": "~1.7.0",
    "typescript": "~4.1.2"
  }
}